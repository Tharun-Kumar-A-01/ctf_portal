# Development override ports
POSTGRES_PORT=5432
VALKEY_PORT=6379

# Database Configuration
POSTGRES_USER=ctf_user
POSTGRES_PASSWORD=ctf_password
POSTGRES_DB=ctf_db
DATABASE_URL=postgresql://ctf_user:ctf_password@127.0.0.1:5432/ctf_db
# In production, docker-compose.yml uses the docker network service names:
# DATABASE_URL=postgresql://ctf_user:ctf_password@db:5432/ctf_db

# Cache Configuration
CACHE_URL=redis://127.0.0.1:6379/0
# In production:
# CACHE_URL=redis://cache:6379/0

# Flask
FLASK_ENV=development
# FLASK_APP=backend.run:create_app()
